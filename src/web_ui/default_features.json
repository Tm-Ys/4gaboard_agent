[
  {
    "name": "项目管理",
    "description": "项目的创建、查看和导航",
    "scenarios": [
      {
        "name": "创建新项目",
        "description": "通过侧边栏的添加项目按钮创建新项目",
        "steps": [
          {"action": "点击添加项目", "target": "添加项目"},
          {"action": "输入项目名称", "target": "Test Project"},
          {"action": "点击提交", "target": "提交"}
        ],
        "expectations": [
          {"description": "页面跳转到项目页面"},
          {"description": "新项目名称出现在页面中"}
        ]
      },
      {
        "name": "通过侧边栏导航到项目",
        "description": "点击侧边栏中的项目名称进入项目",
        "steps": [
          {"action": "点击Getting started", "target": "Getting started"}
        ],
        "expectations": [
          {"description": "进入项目页面"},
          {"description": "页面显示项目看板"}
        ]
      },
      {
        "name": "搜索项目",
        "description": "使用搜索框过滤项目列表",
        "steps": [
          {"action": "输入项目名称", "target": "Getting"},
          {"action": "等待 1 秒"}
        ],
        "expectations": [
          {"description": "侧边栏显示过滤后的项目列表"},
          {"description": "搜索结果匹配关键字"}
        ]
      }
    ]
  },
  {
    "name": "面板管理",
    "description": "看板面板的创建和查看",
    "scenarios": [
      {
        "name": "在项目中添加面板",
        "description": "在项目页面中添加新的看板面板",
        "steps": [
          {"action": "点击Getting started", "target": "Getting started"},
          {"action": "点击添加面板", "target": "添加面板"},
          {"action": "输入面板名称", "target": "New Board"},
          {"action": "点击提交", "target": "提交"}
        ],
        "expectations": [
          {"description": "新面板出现在侧边栏"},
          {"description": "页面显示新面板的看板"}
        ]
      }
    ]
  },
  {
    "name": "看板视图",
    "description": "看板中的列表和卡片",
    "scenarios": [
      {
        "name": "查看项目看板",
        "description": "进入项目后查看默认看板",
        "steps": [
          {"action": "点击Getting started", "target": "Getting started"},
          {"action": "点击Learn 4ga Boards", "target": "Learn 4ga Boards"}
        ],
        "expectations": [
          {"description": "显示看板页面"},
          {"description": "显示看板中的列表和卡片"}
        ]
      },
      {
        "name": "在看板中添加卡片",
        "description": "在看板列表底部添加新卡片",
        "steps": [
          {"action": "点击Getting started", "target": "Getting started"},
          {"action": "点击Learn 4ga Boards", "target": "Learn 4ga Boards"},
          {"action": "点击添加卡片", "target": "添加卡片"},
          {"action": "输入卡片标题", "target": "Test Card"},
          {"action": "点击提交", "target": "提交"}
        ],
        "expectations": [
          {"description": "新卡片出现在列表中"},
          {"description": "卡片标题正确显示"}
        ]
      }
    ]
  }
]
