[
  {
    "name": "Project Management",
    "description": "CRUD operations for projects",
    "scenarios": [
      {
        "name": "Create new project",
        "description": "Create a new project via the Add Project button",
        "steps": [
          {"action": "click Add Project", "target": "Add Project"},
          {"action": "fill Test Project", "target": "Test Project"},
          {"action": "click submit", "target": "submit"}
        ],
        "expectations": [
          {"description": "Redirect to project page"},
          {"description": "New project name appears on page"}
        ]
      },
      {
        "name": "Navigate to project via sidebar",
        "description": "Click project name in sidebar to enter project",
        "steps": [
          {"action": "click Getting started", "target": "Getting started"}
        ],
        "expectations": [
          {"description": "Enter project page"},
          {"description": "Page shows project board"}
        ]
      },
      {
        "name": "Search project",
        "description": "Filter project list using search box",
        "steps": [
          {"action": "fill Getting", "target": "Getting"},
          {"action": "wait 1 second"}
        ],
        "expectations": [
          {"description": "Sidebar shows Getting started project"},
          {"description": "Getting started appears in search results"}
        ]
      }
    ]
  },
  {
    "name": "Board Management",
    "description": "CRUD operations for boards",
    "scenarios": [
      {
        "name": "Add board in project",
        "description": "Add a new kanban board in a project",
        "steps": [
          {"action": "click Getting started", "target": "Getting started"},
          {"action": "click Add Board", "target": "Add Board"},
          {"action": "fill New Board", "target": "New Board"},
          {"action": "click submit", "target": "submit"}
        ],
        "expectations": [
          {"description": "New board appears in sidebar"},
          {"description": "Page shows new board"}
        ]
      }
    ]
  },
  {
    "name": "Kanban Board View",
    "description": "Board view with lists and cards",
    "scenarios": [
      {
        "name": "View project board",
        "description": "Enter project and view default board",
        "steps": [
          {"action": "click Getting started", "target": "Getting started"},
          {"action": "click Learn 4ga Boards", "target": "Learn 4ga Boards"}
        ],
        "expectations": [
          {"description": "Display board page"},
          {"description": "Display lists and cards on board"}
        ]
      },
      {
        "name": "Add card on board",
        "description": "Add a new card at the bottom of a board list",
        "steps": [
          {"action": "click Getting started", "target": "Getting started"},
          {"action": "click Learn 4ga Boards", "target": "Learn 4ga Boards"},
          {"action": "click Add Card", "target": "Add Card"},
          {"action": "fill Test Card", "target": "Test Card"},
          {"action": "click submit", "target": "submit"}
        ],
        "expectations": [
